---
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  class?: string;
}

const { href, variant = 'solid', class: className } = Astro.props;

// Flat brand blue for calls to action; no shadows or 3D effects.
const variants = {
  solid:
    'bg-blue text-paper hover:bg-ink',
  ghost: 'border-2 border-blue text-blue hover:bg-blue hover:text-paper',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-5 py-2.5 font-mono text-sm font-bold tracking-wide uppercase transition-colors motion-reduce:transition-none',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
