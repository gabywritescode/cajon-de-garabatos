---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<h2 id={id} class="font-display text-ink mb-6 flex items-center gap-3 text-sm font-extrabold tracking-[0.18em] uppercase">
  <span class="bg-pink inline-block h-3 w-3 rounded-full mix-blend-multiply" aria-hidden="true"></span>
  {title}
</h2>
