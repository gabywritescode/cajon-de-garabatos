---
import Scribble from '@/components/Scribble.astro';

interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<h2 id={id} class="font-mono text-ink mb-8 flex items-center gap-2 text-sm font-bold tracking-[0.18em] uppercase">
  <Scribble name="star" class="text-green h-6 w-5 -rotate-6" />
  {title}
</h2>
