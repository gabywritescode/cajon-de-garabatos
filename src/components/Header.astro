---
import { SITE } from '@/site.config';
import { UI, pageHref, otherLang, type Lang, type PageKey } from '@/i18n';

interface Props {
  page?: PageKey;
  lang: Lang;
}

const { page, lang } = Astro.props;
const t = UI[lang];
const other = otherLang(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links: { label: string; page: PageKey }[] = [
  { label: t.nav.workshops, page: 'workshops' },
  { label: t.nav.about, page: 'about' },
];
const linkClass = 'font-mono text-[11px] font-bold tracking-wider whitespace-nowrap uppercase sm:text-xs';
---

<header class="border-ink/10 bg-paper/92 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
    <a href={pageHref('home', lang)} class="shrink-0" aria-label={SITE.name}>
      {/* Phones get just the scribble mark so the whole nav fits. */}
      <img src={`${base}/favicon.svg`} alt={SITE.name} width="36" height="36" class="h-9 w-9 sm:hidden" />
      <img src={`${base}/brand/logo.svg`} alt={SITE.name} width="410" height="133" class="hidden h-11 w-auto sm:block" />
    </a>

    <nav class="flex items-center gap-3 sm:gap-5" aria-label={lang === 'es' ? 'Principal' : 'Primary'}>
      {
        links.map((link) => (
          <a
            href={pageHref(link.page, lang)}
            aria-current={page === link.page ? 'page' : undefined}
            class:list={[
              linkClass,
              page === link.page
                ? 'text-blue decoration-coral underline decoration-2 underline-offset-4'
                : 'text-ink-soft hover:text-blue',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={SITE.newsletterUrl} class:list={[linkClass, 'text-ink-soft hover:text-blue']}>
        {t.nav.newsletter}<span aria-hidden="true"> ↗</span>
      </a>
      <a
        href={pageHref(page ?? 'home', other)}
        hreflang={other}
        lang={other}
        title={t.switchTitle}
        class="border-blue text-blue hover:bg-blue hover:text-paper rounded-full border-2 px-2 py-0.5 font-mono text-[11px] font-bold sm:text-xs"
      >
        {t.switchLabel}
      </a>
    </nav>
  </div>
</header>
