---
// "What's on now": the next workshop and the latest issue, taped up like
// notebook pages. Both fill themselves in at build time.
import { SITE } from '@/site.config';
import { UI, pageHref, formatDate, type Lang } from '@/i18n';
import { upcomingWorkshops, workshopDate } from '@/data/workshops';
import { latestIssue } from '@/lib/substack';
import SectionHeading from '@/components/SectionHeading.astro';
import Scribble from '@/components/Scribble.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const workshop = upcomingWorkshops()[0];
const issue = await latestIssue(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const card = 'notebook relative pt-[3.2rem] pr-6 pb-[1.6rem] pl-12 shadow-[0_1px_2px_rgb(0_0_0/0.08),0_8px_24px_-12px_rgb(0_0_0/0.25)]';
const label = 'font-mono text-xs font-bold tracking-[0.18em] uppercase';
const title = 'font-display text-xl font-bold';
---

<section aria-labelledby="board" class="relative mx-auto max-w-4xl px-4 sm:px-6">
  <SectionHeading title={t.boardTitle} id="board" />
  <div class="grid gap-12 sm:grid-cols-2 sm:gap-10">
    <article class:list={[card, 'sm:-rotate-1']}>
      <img src={`${base}/brand/tape-brown.png`} alt="" width="360" height="146" loading="lazy" class="absolute -top-5 left-1/2 w-32 -translate-x-1/2 -rotate-3" />
      <h3 class:list={[label, 'text-blue']}>{t.nextWorkshop}</h3>
      {
        workshop ? (
          <>
            <p class={title}>{workshop.title[lang]}</p>
            <p class="text-ink-soft text-sm font-bold">
              <time datetime={workshop.date}>{formatDate(workshopDate(workshop), lang)}</time>
              {workshop.time && ` · ${workshop.time}`} · {workshop.place[lang]}
            </p>
            <p class="mt-[1.6rem]">{workshop.summary[lang]}</p>
            <p class="mt-[1.6rem] text-sm font-bold">
              {workshop.lumaUrl ? (
                <a href={workshop.lumaUrl} class="text-blue underline">{t.signUp}</a>
              ) : (
                <span class="marker">{t.signUpSoon}</span>
              )}
            </p>
          </>
        ) : (
          <>
            <p class="mt-[1.6rem]">{t.noWorkshop}</p>
            <p class="mt-[1.6rem] text-sm font-bold">
              <a href={`${pageHref('workshops', lang)}#interest`} class="text-blue underline">{t.noWorkshopCta}</a>
            </p>
          </>
        )
      }
    </article>

    <article class:list={[card, 'sm:mt-8 sm:rotate-1']}>
      <img src={`${base}/brand/tape-clear.png`} alt="" width="360" height="86" loading="lazy" class="absolute -top-4 left-1/2 w-36 -translate-x-1/2 rotate-2" />
      <h3 class:list={[label, 'text-blue']}>{t.latestIssue}</h3>
      {
        issue ? (
          <>
            <p class={title}>
              <a href={issue.url} class="hover:text-blue" lang={issue.lang}>{issue.title}</a>
            </p>
            <p class="text-ink-soft text-sm font-bold">
              <time datetime={issue.date.toISOString()}>{formatDate(issue.date, lang)}</time>
            </p>
            {issue.summary && <p class="mt-[1.6rem]" lang={issue.lang}>{issue.summary}</p>}
            <p class="mt-[1.6rem] text-sm font-bold">
              <a href={issue.url} class="text-blue underline">{t.readIssue}</a>
            </p>
          </>
        ) : (
          <p class="mt-[1.6rem]">
            <a href={SITE.newsletterUrl} class="text-blue underline">{t.noIssue}</a>
          </p>
        )
      }
      <Scribble name="star" class="text-coral absolute -right-3 -bottom-4 h-12 w-10 rotate-12" />
    </article>
  </div>
</section>
