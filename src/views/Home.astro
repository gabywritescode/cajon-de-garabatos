---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Noticeboard from '@/components/Noticeboard.astro';
import { SITE } from '@/site.config';
import { UI, pageHref, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
---

<BaseLayout title={SITE.name} page="home">
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 pt-16 pb-20 sm:px-6 sm:pt-24">
    <span
      class="halftone pointer-events-none absolute -top-10 -right-24 h-72 w-72 rounded-full opacity-60 mix-blend-multiply"
      aria-hidden="true"></span>
    <p class="text-ink-soft relative font-mono text-xs tracking-[0.2em] uppercase">{SITE.name}</p>
    <h1 class="font-display riso-title relative mt-4 max-w-3xl text-5xl leading-[0.95] font-extrabold tracking-tight sm:text-7xl">
      {t.heroLead}
      <span class="text-ink block">{t.heroEm}</span>
    </h1>
    <p class="relative mt-8 max-w-xl text-xl">{t.heroBody}</p>
    <div class="relative mt-10 flex flex-wrap gap-4">
      <Button href={SITE.newsletterUrl}>{t.readNewsletter}</Button>
      <Button href={pageHref('workshops', lang)} variant="ghost">{t.seeWorkshops}</Button>
    </div>
  </section>

  <Noticeboard lang={lang} />
</BaseLayout>
