---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Scribble from '@/components/Scribble.astro';
import { Image } from 'astro:assets';
import photo from '@/assets/photos/gabrielle.png';
import { SITE } from '@/site.config';
import { UI, pageHref, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];

const starts = [
  { title: t.startRead, body: t.startReadBody, href: SITE.newsletterUrl, n: '01' },
  { title: t.startWorkshop, body: t.startWorkshopBody, href: pageHref('workshops', lang), n: '02' },
  { title: t.startSubscribe, body: t.startSubscribeBody, href: SITE.subscribeUrl, n: '03' },
];
---

<BaseLayout title={t.aboutTitle} description={t.aboutDescription} page="about">
  <section class="mx-auto grid max-w-4xl gap-12 px-4 pt-16 pb-20 sm:px-6 sm:pt-24 md:grid-cols-[1fr_19rem] md:gap-14">
    <div>
      <h1 class="font-display text-ink text-5xl leading-none font-bold tracking-tight sm:text-6xl">
        {t.aboutHeading}
      </h1>

      <div class="prose prose-lg mt-8 max-w-2xl">
        {
          lang === 'es' ? (
            <>
              <p>
                Soy Gaby, la voz detrás del cajón. Soy de República Dominicana, viví cinco años en Nueva York y ahora
                llevo casi una década viviendo en Madrid.
              </p>
              <p>
                Tengo una doble licenciatura en escritura creativa y comunicación, un máster en filología hispánica y
                soy parte de la promoción VI del programa de profesorado de la Escuela de Escritores.
              </p>
              <p>
                Aunque publiqué mi primer artículo con ocho años y me he dedicado profesionalmente a la redacción en
                start-ups y multinacionales, lo que más me apasiona es la literatura y la enseñanza. He sido tutora de
                escritura, he organizado talleres propios y en mi tiempo libre escribo libros de fantasía y narrativa.
              </p>
              <p>
                A pesar de todas las vueltas que ha dado mi vida, nunca he abandonado la escritura y quiero compartir
                contigo todo lo que he aprendido en estos años.
              </p>
            </>
          ) : (
            <>
              <p>
                I’m Gaby, the voice behind the drawer. I’m from the Dominican Republic. I moved abroad when I turned
                18, spending five years in New York, and have now been based in Madrid for almost a decade.
              </p>
              <p>
                I double-majored in creative writing and communication, earned a master’s degree in Hispanic
                literature, and I’m part of the sixth cohort of the teaching program at the Escuela de Escritores.
              </p>
              <p>
                Although I published my first article at the age of eight and have worked professionally in content
                roles at startups and multinationals, what I’m most passionate about is literature and teaching. I’ve
                been a writing tutor, have organized my own workshops, and write fantasy and literary fiction books in
                my spare time.
              </p>
              <p>
                Despite all the twists and turns my life has taken, I’ve never abandoned writing, and I want to share
                with you everything I’ve learned over these years.
              </p>
            </>
          )
        }
      </div>
    </div>

    {/* Photo with its torn edge and tape, exported from Figma ("Picture of Me"). */}
    <figure class="relative mx-auto w-full max-w-[19rem] rotate-2 md:mt-10">
      <Image
        src={photo}
        alt={t.photoAlt}
        widths={[320, 640, 960]}
        sizes="(min-width: 768px) 19rem, min(19rem, 100vw)"
        format="webp"
        loading="eager"
        class="h-auto w-full drop-shadow-[0_10px_18px_rgb(0_0_0/0.18)]"
      />
      <Scribble name="hearts" class="text-coral absolute -bottom-14 -left-10 h-28 w-22 -rotate-6" />
    </figure>
  </section>

  <section aria-labelledby="start" class="mx-auto max-w-4xl px-4 sm:px-6">
    <SectionHeading title={t.startHere} id="start" />
    <ol class="grid gap-6 sm:grid-cols-3">
      {
        starts.map((s) => (
          <li>
            <a href={s.href} class="group border-mist hover:border-blue bg-paper block h-full rounded-sm border-2 p-5 transition-colors hover:bg-blue/5 motion-reduce:transition-none">
              <span class="text-blue font-display text-4xl font-bold" aria-hidden="true">{s.n}</span>
              <h3 class="font-display mt-2 text-xl font-bold group-hover:underline">{s.title}</h3>
              <p class="text-ink-soft mt-2 text-base">{s.body}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
